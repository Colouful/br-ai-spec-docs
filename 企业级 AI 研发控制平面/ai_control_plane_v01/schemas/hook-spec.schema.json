{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://br-ai-spec.local/schemas/hook-spec.schema.json",
  "title": "Hook 规范协议",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "trigger",
    "severity",
    "enabled",
    "rules"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "blocker"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "message": {
      "type": "string"
    }
  }
}
