{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://br-ai-spec.local/schemas/agent-profile.schema.json",
  "title": "Agent Profile 协议",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "role",
    "responsibilities",
    "permissions",
    "contextAccess",
    "outputs"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": true
    },
    "contextAccess": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
