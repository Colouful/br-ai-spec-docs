{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://br-ai-spec.local/schemas/run-bundle.schema.json",
  "title": "运行包协议",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "changeId",
    "status",
    "taskLevel",
    "createdAt",
    "project",
    "openspec",
    "context",
    "taskDag",
    "worktrees",
    "verification",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "runId": {
      "type": "string"
    },
    "changeId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "waiting-approval",
        "running",
        "verifying",
        "repairing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "taskLevel": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "object",
      "additionalProperties": true
    },
    "openspec": {
      "type": "object",
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "assets": {
      "type": "object",
      "additionalProperties": true
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "taskDag": {
      "type": "object",
      "additionalProperties": true
    },
    "worktrees": {
      "type": "object",
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
