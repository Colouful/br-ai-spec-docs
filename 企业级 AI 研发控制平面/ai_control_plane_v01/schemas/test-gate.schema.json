{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://br-ai-spec.local/schemas/test-gate.schema.json",
  "title": "测试门禁协议",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "taskLevels",
    "commands",
    "passCriteria",
    "evidenceRequired"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "taskLevels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "L1",
          "L2",
          "L3"
        ]
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "passCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRequired": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowSkip": {
      "type": "boolean"
    },
    "skipRequiresReason": {
      "type": "boolean"
    }
  }
}
