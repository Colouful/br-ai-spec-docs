{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://br-ai-spec.local/schemas/worktree-index.schema.json",
  "title": "Worktree 索引协议",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "changeBranch",
    "baseCommit",
    "worktrees"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "runId": {
      "type": "string"
    },
    "changeBranch": {
      "type": "string"
    },
    "baseCommit": {
      "type": "string"
    },
    "worktreesRoot": {
      "type": "string"
    },
    "worktrees": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
